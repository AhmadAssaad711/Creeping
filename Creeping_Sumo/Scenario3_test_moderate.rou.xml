<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vTypeDistribution id="test_dist">

        <vType id="conservative_t"
               probability="0.4"
               accel="2.0" decel="4.5" emergencyDecel="6.0"
               sigma="0.2" minGap="2.5" maxSpeed="13.89"
               speedFactor="0.90" speedDev="0.03"
               tau="1.6" impatience="0.0"
               carFollowModel="IDM"
               color="0,0,200"/>

        <vType id="neutral_t"
               probability="0.3"
               accel="2.8" decel="4.0" emergencyDecel="6.0"
               sigma="0.3" minGap="2.0" maxSpeed="13.89"
               speedFactor="1.0" speedDev="0.05"
               tau="1.1" impatience="0.3"
               carFollowModel="IDM"
               color="0,200,0"/>

        <vType id="aggressive_t"
               probability="0.3"
               accel="3.5" decel="2.8" emergencyDecel="6.0"
               sigma="0.4" minGap="1.2" maxSpeed="13.89"
               speedFactor="1.15" speedDev="0.05"
               tau="0.7" impatience="0.9"
               carFollowModel="IDM"
               color="200,0,0"/>

    </vTypeDistribution>

    <flow id="f_0" begin="0" end="3600" perHour="5400"
          from="E0" to="E1" type="test_dist"/>
    <flow id="f_1" begin="0" end="3600" perHour="1800"
          from="-E1" to="-E0" type="test_dist"/>

</routes>
